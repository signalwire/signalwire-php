#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * secure-default-dump — the PHP port's SECURE-DEFAULT (A1) Layer-D dump program
 * for the cross-port behavioral differ
 * (porting-sdk/scripts/diff_port_secure_default.py).
 *
 * The differ drives the python reference through the secure_default corpus to
 * build the golden token TOPOLOGY, then runs THIS program (which embeds the same
 * two fixtures) and classifies OUR rendered payload the same way.
 *
 * Protocol (the 2026-07-27 redesign — a WIRE payload, not a self-verdict):
 *
 *   {"<fixture id>": {"secure_default_true": bool, "rendered": {<functions[] entry>}}}
 *
 *   secure_default_true — the SDK-RECORDED secure flag for that tool, read back
 *     from the live registry (``AgentBase::getTools()[$name]['_secure']``). It is
 *     deliberately NOT the value this program passed to ``defineTool``: echoing
 *     the input back would make the field incapable of ever failing, which is
 *     precisely the vacuity this redesign exists to close.
 *   rendered — that tool's own ``SWAIG.functions[]`` entry, VERBATIM, with every
 *     token VALUE replaced by the corpus placeholder ``<TOKEN>`` (the values are
 *     HMACs and vary per run; the KEY PATH is the whole contract and is preserved
 *     exactly).
 *
 * This program makes NO judgement about whether the render is correct — the
 * differ derives ``has_own_webhook`` and ``token_carrier`` from the keys. The
 * contract it pins (signalwire-python core/agent_base.py:1085-1099): a SECURE
 * tool's entry carries its own ``web_hook_url`` with a ``__token`` query param;
 * an INSECURE tool's entry carries NO ``web_hook_url`` key at all and falls back
 * to the shared ``SWAIG.defaults.web_hook_url``.
 *
 * Only stdout carries JSON; setup noise goes to stderr.
 *
 * Run from the signalwire-php repo root:
 *
 *   php bin/secure-default-dump
 *
 * Copyright (c) 2025 SignalWire
 * Licensed under the MIT License.
 */

use SignalWire\Agent\AgentBase;
use SignalWire\SWAIG\FunctionResult;

$autoload = dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "secure-default-dump: vendor/autoload.php not found; run composer install\n");
    exit(1);
}
require_once $autoload;

// The FIXED call_id the corpus renders with, so a secure tool deterministically
// gets a __token. Mirrors secure_default_corpus.CALL_ID.
const SD_CALL_ID = 'call-secure-default-fixture';

// Mirrors secure_default_corpus.TOKEN_PLACEHOLDER.
const SD_TOKEN_PLACEHOLDER = '<TOKEN>';

/**
 * Build a fresh agent, define one tool, render the SWML with the fixed call_id,
 * and emit {secure_default_true, rendered} for the differ to classify.
 *
 * @param callable(AgentBase):void $define defines the tool on the agent.
 * @return array{secure_default_true: bool, rendered: array<string, mixed>}
 */
function sd_emit(string $toolName, callable $define): array
{
    $agent = new AgentBase(
        name: 'demo',
        route: '/demo',
        basicAuthUser: 'u',
        basicAuthPassword: 'p',
    );
    $define($agent);

    // The SDK-RECORDED flag, read back from the registry — never the value we
    // passed in (see the header: an echoed input can never red).
    $tool = $agent->getTools()[$toolName] ?? [];
    $recordedSecure = ($tool['_secure'] ?? false) === true;

    $doc = $agent->renderSwml(null, [], SD_CALL_ID);

    return [
        'secure_default_true' => $recordedSecure,
        'rendered'            => sd_redact(sd_function_entry($doc, $toolName)),
    ];
}

/**
 * Locate the SWAIG function entry by name in the rendered doc.
 *
 * @param array<string, mixed> $doc
 * @return array<string, mixed>
 */
function sd_function_entry(array $doc, string $toolName): array
{
    foreach (sd_swaig_functions($doc) as $fn) {
        if (is_array($fn) && ($fn['function'] ?? null) === $toolName) {
            /** @var array<string, mixed> $fn */
            return $fn;
        }
    }
    return [];
}

/**
 * Replace every nondeterministic token VALUE (an HMAC) with the corpus
 * placeholder while preserving every KEY and key path exactly — both a
 * token-suffixed field and a token-suffixed query parameter on a URL value.
 * Mirrors diff_port_secure_default.redact_entry so the differ's re-application
 * is a no-op.
 *
 * @param array<string, mixed> $entry
 * @return array<string, mixed>
 */
function sd_redact(array $entry): array
{
    $out = [];
    foreach ($entry as $key => $value) {
        if (is_string($value) && str_ends_with(strtolower((string) $key), 'token')) {
            $out[$key] = SD_TOKEN_PLACEHOLDER;
            continue;
        }
        if (is_string($value) && (str_contains($value, '://') || str_starts_with($value, '/'))) {
            $out[$key] = sd_redact_url($value);
            continue;
        }
        $out[$key] = $value;
    }
    return $out;
}

/** Replace the VALUE of every token-suffixed query parameter in a URL. */
function sd_redact_url(string $url): string
{
    $q = strpos($url, '?');
    if ($q === false) {
        return $url;
    }
    $rebuilt = [];
    foreach (explode('&', substr($url, $q + 1)) as $pair) {
        $eq  = strpos($pair, '=');
        $key = $eq === false ? $pair : substr($pair, 0, $eq);
        if ($eq !== false && str_ends_with(strtolower($key), 'token')) {
            $rebuilt[] = $key . '=' . SD_TOKEN_PLACEHOLDER;
        } else {
            $rebuilt[] = $pair;
        }
    }
    return substr($url, 0, $q + 1) . implode('&', $rebuilt);
}

/**
 * Walk sections.main → the ``ai`` verb → SWAIG.functions.
 *
 * @param array<string, mixed> $doc
 * @return list<mixed>
 */
function sd_swaig_functions(array $doc): array
{
    $main = $doc['sections']['main'] ?? null;
    if (!is_array($main)) {
        return [];
    }
    foreach ($main as $section) {
        if (!is_array($section) || !isset($section['ai']) || !is_array($section['ai'])) {
            continue;
        }
        $functions = $section['ai']['SWAIG']['functions'] ?? null;
        if (is_array($functions)) {
            return array_values($functions);
        }
    }
    return [];
}

$out = [];

// A1 (a): a tool defined with NO explicit secure= must default to SECURE →
// its rendered entry carries its own web_hook_url with a __token query param.
$out['define_tool_default_is_secure'] = sd_emit(
    'sd_default_secure',
    static function (AgentBase $a): void {
        $a->defineTool(
            'sd_default_secure',
            'A default-secure tool',
            ['q' => ['type' => 'string']],
            static fn (array $args, array $raw): FunctionResult => new FunctionResult(),
        );
    },
);

// A1 (b): a tool defined with secure=false must be INSECURE → NO per-tool
// web_hook_url key at all (it falls back to SWAIG.defaults.web_hook_url).
$out['define_tool_explicit_insecure'] = sd_emit(
    'sd_explicit_insecure',
    static function (AgentBase $a): void {
        $a->defineTool(
            'sd_explicit_insecure',
            'An explicitly-insecure tool',
            ['q' => ['type' => 'string']],
            static fn (array $args, array $raw): FunctionResult => new FunctionResult(),
            secure: false,
        );
    },
);

fwrite(STDOUT, json_encode($out, JSON_UNESCAPED_SLASHES) . "\n");
exit(0);
